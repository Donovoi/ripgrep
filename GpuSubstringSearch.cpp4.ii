template<typename TupleType>
struct find_if_functor
{
  
# 58 "/usr/include/thrust/system/detail/generic/find.inl"
 __attribute__((
# 58 "/usr/include/thrust/system/detail/generic/find.inl" 3 4
 host
# 58 "/usr/include/thrust/system/detail/generic/find.inl"
 )) __attribute__((
