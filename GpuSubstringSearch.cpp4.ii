void iter_swap(ForwardIterator1 iter1, ForwardIterator2 iter2)
{

  using namespace thrust::detail;

  typedef typename thrust::iterator_value<ForwardIterator1>::type T;

  T temp = *iter1;
  *iter1 = *iter2;
  *iter2 = temp;
}



