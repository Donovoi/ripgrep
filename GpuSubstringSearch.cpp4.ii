        device
# 42 "/usr/include/thrust/system/detail/sequential/reduce.h"
        ))
  
# 43 "/usr/include/thrust/system/detail/sequential/reduce.h" 3 4
 OutputType reduce(sequential::execution_policy<DerivedPolicy> &,
                    InputIterator begin,
                    InputIterator end,
                    OutputType init,
                    BinaryFunction binary_op)
{

  thrust::detail::wrapped_function<
    BinaryFunction,
    OutputType
  > wrapped_binary_op(binary_op);


  OutputType result = init;

  while(begin != end)
  {
    result = wrapped_binary_op(result, *begin);
    ++begin;
  }

  return result;
}


}
}
