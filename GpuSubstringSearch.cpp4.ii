              SizeValuePairT (&scan_items)[ITEMS_PER_THREAD])
  {

#pragma unroll
    for (int ITEM = 0; ITEM < ITEMS_PER_THREAD; ++ITEM)
    {
      values[ITEM] = scan_items[ITEM].value;
    }
  }

