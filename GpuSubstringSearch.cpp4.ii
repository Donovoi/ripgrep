    {

        RAKING_THREADS = BlockRakingLayout::RAKING_THREADS,


        SEGMENT_LENGTH = BlockRakingLayout::SEGMENT_LENGTH,


        WARP_SYNCHRONOUS = (int(BLOCK_THREADS) == int(RAKING_THREADS)),
