            identity_<signed long>,
            identity_<intmax_t>
          >
        >
      >::type type;
};


template<typename Number>
  struct numeric_difference
    : eval_if<
      is_integral<Number>::value,
      integer_difference<Number>,
      identity_<Number>
    >
{};


