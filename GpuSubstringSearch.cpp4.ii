 __attribute__((
# 317 "/usr/include/thrust/system/cuda/detail/extrema.h" 3 4
 host
# 317 "/usr/include/thrust/system/cuda/detail/extrema.h"
 ))
  
# 318 "/usr/include/thrust/system/cuda/detail/extrema.h" 3 4
 T extrema(execution_policy<Derived>& policy,
            InputIt first,
            Size num_items,
            BinaryOp binary_op,
            T*)
  {
    size_t temp_storage_bytes = 0;
    cudaStream_t stream = cuda_cub::stream(policy);

    cudaError_t status;
    if (num_items <= thrust::detail::integer_traits<thrust::detail::int32_t>::const_max) { auto num_items_fixed = static_cast<thrust::detail::int32_t>(num_items); status = doit_step<T> (__null, temp_storage_bytes, first, num_items_fixed, binary_op, reinterpret_cast<T*>(__null), stream); } else { auto num_items_fixed = static_cast<thrust::detail::int64_t>(num_items); status = doit_step<T> (__null, temp_storage_bytes, first, num_items_fixed, binary_op, reinterpret_cast<T*>(__null), stream); }

                                                           ;
    cuda_cub::throw_on_error(status, "extrema failed on 1st step");

    size_t allocation_sizes[2] = {sizeof(T*), temp_storage_bytes};
    void * allocations[2] = {__null, __null};

    size_t storage_size = 0;
    status = core::alias_storage(__null,
                                 storage_size,
                                 allocations,
                                 allocation_sizes);
    cuda_cub::throw_on_error(status, "extrema failed on 1st alias storage");


    thrust::detail::temporary_array<thrust::detail::uint8_t, Derived>
      tmp(policy, storage_size);
    void *ptr = static_cast<void*>(tmp.data().get());

    status = core::alias_storage(ptr,
                                 storage_size,
                                 allocations,
                                 allocation_sizes);
    cuda_cub::throw_on_error(status, "extrema failed on 2nd alias storage");

    T* d_result = thrust::detail::aligned_reinterpret_cast<T*>(allocations[0]);

    if (num_items <= thrust::detail::integer_traits<thrust::detail::int32_t>::const_max) { auto num_items_fixed = static_cast<thrust::detail::int32_t>(num_items); status = doit_step<T> (allocations[1], temp_storage_bytes, first, num_items_fixed, binary_op, d_result, stream); } else { auto num_items_fixed = static_cast<thrust::detail::int64_t>(num_items); status = doit_step<T> (allocations[1], temp_storage_bytes, first, num_items_fixed, binary_op, d_result, stream); }

                                                          ;
    cuda_cub::throw_on_error(status, "extrema failed on 2nd step");

    status = cuda_cub::synchronize(policy);
    cuda_cub::throw_on_error(status, "extrema failed to synchronize");

    T result = cuda_cub::get_value(policy, d_result);

    return result;
  }

