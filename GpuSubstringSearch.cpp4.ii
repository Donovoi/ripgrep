struct PerDeviceAttributeCache
{
    struct DevicePayload
    {
        int attribute;
        cudaError_t error;
    };





    enum DeviceEntryStatus
    {
        DeviceEntryEmpty = 0,
        DeviceEntryInitializing,
        DeviceEntryReady
    };

    struct DeviceEntry
    {
        std::atomic<DeviceEntryStatus> flag;
        DevicePayload payload;
    };

private:
    std::array<DeviceEntry, (128)> entries_;

public:



    
# 246 "/usr/include/cub/util_device.cuh"
