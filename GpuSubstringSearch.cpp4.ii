 )) __inline__ __attribute__((always_inline)) 
# 451 "/usr/include/cub/agent/agent_reduce_by_key.cuh" 3 4
                            void
  Scatter(KeyValuePairT (&scatter_items)[ITEMS_PER_THREAD],
          OffsetT (&segment_flags)[ITEMS_PER_THREAD],
          OffsetT (&segment_indices)[ITEMS_PER_THREAD],
          OffsetT num_tile_segments,
          OffsetT num_tile_segments_prefix)
  {


    if (TWO_PHASE_SCATTER && (num_tile_segments > BLOCK_THREADS))
    {
      ScatterTwoPhase(scatter_items,
                      segment_flags,
                      segment_indices,
                      num_tile_segments,
                      num_tile_segments_prefix);
    }
    else
    {
      ScatterDirect(scatter_items, segment_flags, segment_indices);
    }
  }
# 496 "/usr/include/cub/agent/agent_reduce_by_key.cuh" 3 4
  template <bool IS_LAST_TILE>
  
# 497 "/usr/include/cub/agent/agent_reduce_by_key.cuh"
 __attribute__((
# 497 "/usr/include/cub/agent/agent_reduce_by_key.cuh" 3 4
 device
