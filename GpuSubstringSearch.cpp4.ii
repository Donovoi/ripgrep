template<typename DerivedPolicy,
         typename InputIterator,
         typename OutputType,
         typename BinaryFunction>

# 42 "/usr/include/thrust/system/detail/sequential/reduce.h"
__attribute__((
# 42 "/usr/include/thrust/system/detail/sequential/reduce.h" 3 4
host
# 42 "/usr/include/thrust/system/detail/sequential/reduce.h"
