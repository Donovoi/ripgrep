                        }


                        flag_status |= (peer_flag_status & SEEN);
                    }
                }
                else
                {

                    if (!flag_status)
                    {
                        input = reduction_op(input, peer_addend);
                        flag_status |= peer_flag_status;
                    }

                }
            }
        }

        return input;
    }
