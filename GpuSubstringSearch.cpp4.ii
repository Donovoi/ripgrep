        STEPS = Log2<LOGICAL_WARP_THREADS>::VALUE,


        LOGICAL_WARPS = (1 << (5)) / LOGICAL_WARP_THREADS,


        SHFL_C = ((1 << (5)) - LOGICAL_WARP_THREADS) << 8

    };

