    if (num_items <= thrust::detail::integer_traits<thrust::detail::int32_t>::const_max) { auto num_items_fixed = static_cast<thrust::detail::int32_t>(num_items); status = Dispatch32::Dispatch (tmp.data().get(), tmp_size, keys_unwrap, values_unwrap, result_unwrap, equality_op, scan_op, cub::NullType{}, num_items_fixed, stream); } else { auto num_items_fixed = static_cast<thrust::detail::int64_t>(num_items); status = Dispatch64::Dispatch (tmp.data().get(), tmp_size, keys_unwrap, values_unwrap, result_unwrap, equality_op, scan_op, cub::NullType{}, num_items_fixed, stream); }
