                          void LoadDirectBlocked(
    int linear_tid,
    InputIteratorT block_itr,
    InputT (&items)[ITEMS_PER_THREAD])
{

#pragma unroll
    for (int ITEM = 0; ITEM < ITEMS_PER_THREAD; ITEM++)
    {
        items[ITEM] = block_itr[(linear_tid * ITEMS_PER_THREAD) + ITEM];
    }
}
