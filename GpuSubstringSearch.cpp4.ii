# 860 "/usr/include/thrust/system/cuda/detail/reduce.h" 3 4
 T reduce(execution_policy<Derived>& policy,
           InputIt first,
           Size num_items,
           T init,
           BinaryOp binary_op)
  {
    if (num_items == 0)
      return init;

    size_t temp_storage_bytes = 0;
    cudaStream_t stream = cuda_cub::stream(policy);

    cudaError_t status;
    status = doit_step(__null,
                       temp_storage_bytes,
